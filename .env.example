# Copy to .env.local and fill in. NEVER commit .env.local.
# Under the split deployment these live in TWO places:
#   - GitHub repo secrets  -> the pipeline (Actions)
#   - Vercel project env   -> the web app
# Rotating a key is a two-place operation.

DATABASE_URL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# VERIFIED 2026-08-21: llama-3.3-70b-versatile is DELISTED from Groq.
# Both default to gpt-oss-120b (30 RPM / 8K TPM / 1K RPD / 200K TPD free tier).
GROQ_MODEL_SCORING=openai/gpt-oss-120b
GROQ_MODEL_DRAFTING=openai/gpt-oss-120b

RESEND_API_KEY=
ADMIN_TOKEN=
DASHBOARD_TOKEN=
APP_BASE_URL=http://localhost:3000

# SEC REQUIRES this format: "Name email@domain"
SEC_USER_AGENT=

# All mail goes here while DIGEST_TEST_MODE is true (the default).
DIGEST_TEST_RECIPIENT=
DIGEST_TEST_MODE=true

FEWSHOT_ENABLED=false

# ── Web search (optional) ───────────────────────────────────────────────────
# Provider for company/website/news lookup. Defaults to 'purili', which needs
# no key at all, so the pipeline runs without any of these set.
#   serper  Google SERP JSON. Best recall. 2,500 free once, then $1/1k.
#   youcom  $100 one-time signup credit (~20k queries). Best for the backfill.
#   linkup  $20/month RECURRING credit (~4k). Best for the weekly news job.
#   tavily  1,000/month, no credit card. Returns full page text free.
SEARCH_PROVIDER=purili
SERPER_API_KEY=
YOUCOM_API_KEY=
LINKUP_API_KEY=
TAVILY_API_KEY=

# Hard ceiling on search requests per process. Guards against a loop bug
# burning paid credits.
SEARCH_MAX_REQUESTS=3000
